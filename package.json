{
	"name": "cosmiconfig-loader-pkl",
	"version": "0.1.0",
	"description": "Loader for Apple's Pkl format.",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/cosmiconfig-loader-pkl.git"
	},
	"keywords": [
		"coscmiconfig",
		"pkl",
		"loader",
		"load",
		"configuration",
		"config"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist/",
		"LICENSE",
		"readme.markdown"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "vitest run"
	},
	"dependencies": {
		"@pkl-community/pkl": "^0.30.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@e18e/cli": "^0.7.0",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"concurrently": "^10.0.5",
		"np": "^12.0.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
